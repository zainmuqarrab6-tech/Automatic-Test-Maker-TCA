DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve favicon directly to prevent 503 proxy errors
  RewriteRule ^favicon\.ico$ favicon.ico [L]

  # Serve real physical files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow Node.js API endpoints and PHP API to pass through
  RewriteRule ^(api/|api\.php|public/api\.php) - [L]

  # Serve index.html directly for root requests to bypass proxy 503
  RewriteRule ^$ index.html [L]

  # SPA fallback for all non-file client routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ index.html [L]
</IfModule>
