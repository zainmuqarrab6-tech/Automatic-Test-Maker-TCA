DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Immediately route root / to index.html (Bypasses LiteSpeed Node.js 503 proxy)
  RewriteRule ^$ index.html [L]

  # 2. Serve favicon directly
  RewriteRule ^favicon\.ico$ favicon.ico [L]

  # 3. Serve real physical files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Allow PHP API endpoints to pass through
  RewriteRule ^(api\.php|public/api\.php) - [L]

  # 5. SPA fallback for all non-file client routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ index.html [L]
</IfModule>
